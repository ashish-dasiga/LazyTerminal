{
  "name": "lazy-terminal",
  "productName": "Lazy Terminal",
  "version": "1.0.0",
  "description": "Lazy Terminal — Mobile-first, local-first Android + Windows PC development companion",
  "author": "Lazy Terminal",
  "main": "dist-electron/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "host": "tsx src/host/companionServer.ts",
    "desktop": "electron dist-electron/main.cjs",
    "build": "vite build",
    "start": "node server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron dist-installer",
    "lint": "tsc --noEmit",
    "test:host": "node --import tsx --test src/host/__tests__/hostCompanion.test.ts src/host/__tests__/aiProviders.test.ts",
    "test:shreya": "node --import tsx --test tests/cliDetector.test.ts tests/runDebug.test.ts tests/preview.test.ts",
    "test:deeksha": "node --import tsx --test src/tests/*.test.ts",
    "test": "tsx tests/fsGit.test.ts && tsx tests/hostApi.test.ts && node --import tsx --test src/tests/*.test.ts",
    "test:pairing": "node --import tsx --test tests/realPairingIntegration.test.ts",
    "test:e2e:pairing": "node ./node_modules/@playwright/test/cli.js test e2e/mobile-pairing.spec.ts",
    "test:e2e": "tsx tests/e2ePlaywright.test.ts",
    "test:portal": "node scripts/verify-simplified-portal.cjs",
    "test:apps": "tsx tests/appsVerification.test.ts",
    "test:sync": "tsx tests/laptopSyncFlowPlaywright.test.ts",
    "companion": "python lazy_terminal_companion.py",
    "build:apk": "node scripts/build_android_apk.cjs",
    "build:exe": "node scripts/build_windows_exe.cjs"
  },
  "build": {
    "appId": "com.lazyterminal.desktop",
    "productName": "Lazy Terminal",
    "copyright": "Copyright © 2026 Lazy Terminal",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/downloads/app_icon.ico",
      "icon.jpeg",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/downloads/app_icon.ico",
      "artifactName": "LazyTerminal-Windows-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lazy Terminal",
      "installerIcon": "public/downloads/app_icon.ico",
      "uninstallerIcon": "public/downloads/app_icon.ico",
      "license": "LICENSE.txt",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
