# Safe placeholders only. Copy to .env only if selected tooling needs it.
# Never commit .env or real credentials.
APP_ENV=development
LOG_LEVEL=info

# The pairing secret is generated at runtime by the Windows app.
# Do not set a static pairing secret here.

# Optional cloud mode remains disabled unless explicitly configured.
OPTIONAL_CLOUD_MODE=disabled
# OPTIONAL_CLOUD_PROVIDER=
# OPTIONAL_CLOUD_WORKSPACE_ID=
